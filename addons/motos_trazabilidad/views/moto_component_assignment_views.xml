<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_moto_component_assignment_list" model="ir.ui.view">
        <field name="name">moto.component.assignment.list</field>
        <field name="model">moto.component.assignment</field>
        <field name="arch" type="xml">
            <list string="Trazabilidad de componentes">
                <field name="motorcycle_lot_id"/>
                <field name="component_lot_id"/>
                <field name="installed_date"/>
                <field name="removed_date"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_moto_component_assignment_form" model="ir.ui.view">
        <field name="name">moto.component.assignment.form</field>
        <field name="model">moto.component.assignment</field>
        <field name="arch" type="xml">
            <form string="Asignación de componente">
                <header>
                    <button name="action_mark_removed" type="object" string="Registrar retiro" class="btn-secondary" invisible="not active"/>
                    <field name="active" widget="boolean_toggle" readonly="1"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="motorcycle_lot_id" domain="[('is_motorcycle', '=', True)]"/>
                            <field name="component_lot_id"/>
                        </group>
                        <group>
                            <field name="installed_date"/>
                            <field name="removed_date" readonly="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group><field name="notes" placeholder="Motivo del cambio, técnico, orden de trabajo..."/></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_moto_component_assignment" model="ir.actions.act_window">
        <field name="name">Trazabilidad de componentes</field>
        <field name="res_model">moto.component.assignment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_moto_trace_root" name="Trazabilidad de motos" parent="stock.menu_stock_root" sequence="85" groups="stock.group_stock_user"/>
    <menuitem id="menu_moto_component_assignment" name="Componentes instalados" parent="menu_moto_trace_root" action="action_moto_component_assignment" sequence="10" groups="stock.group_stock_user"/>
</odoo>
