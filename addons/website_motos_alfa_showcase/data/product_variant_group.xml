<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- [Inventario de motos] Activa «Variantes» (Ajustes → Inventario/Ventas): colores de la moto, menú «Atributos»,
         pestaña «Atributos y variantes» y «Fotos 360°» de cada color. Es <function> y no <record id="base.group_user">
         porque ese registro es noupdate: con -u Odoo lo saltaría. Agregar el grupo otra vez no duplica nada. -->
    <function model="res.groups" name="write">
        <value eval="[ref('base.group_user')]"/>
        <value eval="{'implied_ids': [(4, ref('product.group_product_variant'))]}"/>
    </function>

</odoo>
