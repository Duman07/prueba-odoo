<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Página de la Hero Hunk 150 XT.
        Usa website.layout, por lo que hereda encabezado, menú y pie de página del sitio.
        Los contenedores con data-moto-slot son los puntos de montaje para las etapas
        siguientes (modelo 3D, animación de entrada, visor 360°, ficha técnica y datos comerciales).
    -->
    <template id="hunk_150_xt_page" name="Hunk 150 XT">
        <t t-call="website.layout">
            <t t-set="pageName" t-value="'hunk-150-xt'"/>
            <div id="wrap" class="oe_structure o_moto_showcase" data-moto-name="Hunk 150 XT" data-model-src="">

                <!-- 1. Presentación + escenario del modelo 3D y la animación de entrada -->
                <section class="o_moto_section o_moto_hero">
                    <div class="container">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb o_moto_breadcrumb">
                                <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Hunk 150 XT</li>
                            </ol>
                        </nav>
                        <div class="row align-items-center g-4 g-lg-5">
                            <div class="col-lg-5">
                                <p class="o_moto_eyebrow">Hero · Hunk</p>
                                <h1 class="o_moto_title">Hunk 150 XT</h1>
                                <div class="o_moto_cta">
                                    <a href="/contactus" class="btn btn-primary btn-lg">Contáctanos</a>
                                    <a href="#moto-360" class="btn btn-outline-secondary btn-lg">Ver en 360°</a>
                                </div>
                            </div>
                            <div class="col-lg-7">
                                <div class="o_moto_stage o_moto_placeholder o_not_editable" data-moto-slot="model3d" data-moto-intro="enter,accelerate,turnRight,brake,settle">
                                    <span class="o_moto_placeholder_title">Modelo 3D · GLB / glTF</span>
                                    <span class="o_moto_placeholder_hint">Animación de entrada: entrada · aceleración · giro a la derecha · frenada</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 2. Visor interactivo 360° -->
                <section id="moto-360" class="o_moto_section">
                    <div class="container">
                        <p class="o_moto_eyebrow">Vista interactiva</p>
                        <h2 class="o_moto_heading">Explórala en 360°</h2>
                        <div class="row g-4">
                            <div class="col-lg-8">
                                <div class="o_moto_viewer o_moto_placeholder o_not_editable" data-moto-slot="viewer360">
                                    <span class="o_moto_placeholder_title">Visor 360°</span>
                                    <span class="o_moto_placeholder_hint">Rotación y acercamiento a los detalles</span>
                                </div>
                            </div>
                            <div class="col-lg-4 d-flex flex-column gap-4">
                                <div class="o_moto_placeholder o_moto_placeholder_sm o_not_editable" data-moto-slot="colors">
                                    <span class="o_moto_placeholder_title">Colores disponibles</span>
                                </div>
                                <div class="o_moto_placeholder o_moto_placeholder_sm flex-grow-1 o_not_editable" data-moto-slot="hotspots">
                                    <span class="o_moto_placeholder_title">Puntos destacados</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 3. Especificaciones técnicas -->
                <section id="moto-specs" class="o_moto_section o_moto_section_alt">
                    <div class="container">
                        <p class="o_moto_eyebrow">Ficha técnica</p>
                        <h2 class="o_moto_heading">Especificaciones técnicas</h2>
                        <div class="row g-3 mb-4" aria-hidden="true">
                            <div class="col-6 col-lg-3"><div class="o_moto_skeleton"/></div>
                            <div class="col-6 col-lg-3"><div class="o_moto_skeleton"/></div>
                            <div class="col-6 col-lg-3"><div class="o_moto_skeleton"/></div>
                            <div class="col-6 col-lg-3"><div class="o_moto_skeleton"/></div>
                        </div>
                        <div class="o_moto_placeholder o_not_editable" data-moto-slot="specs">
                            <span class="o_moto_placeholder_title">Tabla de especificaciones</span>
                            <span class="o_moto_placeholder_hint">Pendiente de datos validados</span>
                        </div>
                    </div>
                </section>

                <!-- 4. Información comercial, financiación y contacto -->
                <section id="moto-comercial" class="o_moto_section">
                    <div class="container">
                        <p class="o_moto_eyebrow">Información comercial</p>
                        <h2 class="o_moto_heading">Precio y financiación</h2>
                        <div class="row g-4">
                            <div class="col-lg-6">
                                <div class="o_moto_placeholder h-100 o_not_editable" data-moto-slot="pricing">
                                    <span class="o_moto_placeholder_title">Precio y financiación</span>
                                    <span class="o_moto_placeholder_hint">Pendiente de datos validados</span>
                                </div>
                            </div>
                            <div class="col-lg-6 d-flex flex-column gap-4">
                                <div class="o_moto_placeholder o_moto_placeholder_sm o_not_editable" data-moto-slot="benefits">
                                    <span class="o_moto_placeholder_title">Garantía y condiciones</span>
                                </div>
                                <div class="o_moto_contact">
                                    <div>
                                        <h3 class="o_moto_contact_title">¿Quieres más información?</h3>
                                        <p class="o_moto_contact_text">Escríbenos y un asesor te contactará.</p>
                                    </div>
                                    <a href="/contactus" class="btn btn-primary">Contáctanos</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>

    <!--
        Página del sitio: se crea sin publicar hasta que el contenido esté validado.
        noupdate evita que una actualización del módulo revierta la publicación hecha desde el sitio.
    -->
    <data noupdate="1">
        <record id="hunk_150_xt_website_page" model="website.page">
            <field name="url">/hunk-150-xt</field>
            <field name="view_id" ref="hunk_150_xt_page"/>
            <field name="is_published" eval="False"/>
            <field name="website_indexed" eval="False"/>
        </record>
    </data>

</odoo>
