<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_actividad_list" model="ir.ui.view">
        <field name="name">actividades.pendientes.list</field>
        <field name="model">actividades.pendientes</field>
        <field name="arch" type="xml">
            <list string="Actividades Pendientes">
                <field name="name"/>
                <field name="description"/>
                <field name="done"/>
                <field name="date_time"/>
            </list>
        </field>
    </record>

    <record id="view_actividad_form" model="ir.ui.view">
        <field name="name">actividades.pendientes.form</field>
        <field name="model">actividades.pendientes</field>
        <field name="arch" type="xml">
            <form string="Actividad Pendiente">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                      <button name = "action_toggle_hecho"
                              type = "object"
                              class = "oe_stat_button">
                         <field name= "done"
                                widget="boolean_button"
                                options="{'terminology':'done'}"/>
                       </button>
                    </div>

                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="contacto_id"/>
                        <field name="date_time"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_actividades_pendientes"
            model="ir.actions.act_window">
        <field name="name">Actividades Pendientes</field>
        <field name="res_model">actividades.pendientes</field>
        <field name="view_mode">list,form</field>
    </record>
<record id="view_actividades_pendientes_search"
        model="ir.ui.view">
    <field name="name">actividades.pendientes.search</field>
    <field name="model">actividades.pendientes</field>
    <field name="arch" type="xml">
        <search string="Buscar actividades">

            <field name="name"/>
            <field name="contacto_id"/>
            <field name="date_time"/>

            <filter name="pendientes"
                    string="Pendientes"
                    domain="[('done', '=', False)]"/>

            <filter name="completadas"
                    string="Completadas"
                    domain="[('done', '=', True)]"/>

        </search>
    </field>
</record>

    <menuitem id="menu_actividades_pendientes_root"
              name="Actividades Pendientes"
              sequence="10"
              groups="base.group_user"/>

    <menuitem id="menu_actividades_pendientes"
              name="Mis pendientes"
              parent="menu_actividades_pendientes_root"
              action="action_actividades_pendientes"
              sequence="10"
              groups="base.group_user"/>
</odoo>